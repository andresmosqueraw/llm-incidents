moothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"qsRWxXDFi\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[4,\"strong\",null,[5,\"RAND Europe / UK AISI / Mila — cabinet-level AI crisis exercises\"]]]],[5,\" (1 July 2026). Two-turn \\\"Day After\\\" methodology, 15–20 senior officials per session, run in Berlin, The Hague and Paris. The scenario is criminal misuse of a national champion model — deliberately \"],[4,\"em\",null,[5,\"not\"]],[5,\" this incident, which is the gap.\"]]]],[4,\"h4\",{\"dir\":\"ltr\"},[5,\"Incident data infrastructure\"]],[4,\"ul\",{\"dir\":\"ltr\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[2,{\"href\":\"https://oecd.ai/incidents\",\"openInNewTab\":false,\"smoothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"qsRWxXDFi\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[4,\"strong\",null,[5,\"OECD AI Incidents Monitor\"]]]],[5,\" · \"],[4,\"strong\",null,[5,\"AI Incident Database\"]],[5,\" (Responsible AI Collaborative) · \"],[4,\"strong\",null,[5,\"MIT AI Risk Initiative's AI Incident Tracker and FLARE-AI\"]],[5,\".\"]]]]]",{"type":27,"value":35},{"collectionId":29,"pointer":36},"[1,[4,\"h1\",{\"dir\":\"auto\"},[5,\"Judging Criteria\"]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Dimension 1: Impact Potential & Innovation\"]],[4,\"p\",{\"dir\":\"auto\"},[4,\"em\",null,[5,\"How much would this matter for AI safety if it worked? How innovative is it?\"],[4,\"br\",null],[5,\"For scores of 4-5: is this actually new to the field, or replicating recent work?\"]]],[4,\"figure\",{\"className\":\"framer-table-wrapper\"},[4,\"table\",null,[4,\"tbody\",null,[4,\"tr\",null,[4,\"th\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"Score\"]]],[4,\"th\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"Description\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"1\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Negligible.\"]],[5,\" No clear problem addressed, or no meaningful novelty.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"2\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Limited.\"]],[5,\" Addresses a real problem but with a generic or well-trodden approach. Incremental at best.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"3\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Moderate.\"]],[5,\" Clear problem with a reasonable approach; some novelty in framing or method beyond routine application of existing tools.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"4\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Significant.\"]],[5,\" Important problem with an original approach, or identifies a neglected problem area. A valuable contribution others could build on.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"5\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Exceptional.\"]],[5,\" Tackles a critical AI safety problem with a genuinely novel approach, or opens a new research direction. Clear theory of change. You'd be excited to share this with researchers in the area.\"]]]]]]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Dimension 2: Execution Quality\"]],[4,\"p\",{\"dir\":\"auto\"},[4,\"em\",null,[5,\"How sound are methodology, implementation, and findings?\"]]],[4,\"figure\",{\"className\":\"framer-table-wrapper\"},[4,\"table\",null,[4,\"tbody\",null,[4,\"tr\",null,[4,\"th\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"Score\"]]],[4,\"th\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"Description\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"1\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Seriously flawed.\"]],[5,\" Methodology broken, results uninterpretable, or implementation doesn't work.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"2\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Weak.\"]],[5,\" Approach has significant gaps: missing validation, flawed experimental design, or incomplete implementation.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"3\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Competent.\"]],[5,\" Technically solid given the short duration. Methodology makes sense, results are interpretable, limitations acknowledged, work builds toward clear conclusions.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"4\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Strong.\"]],[5,\" Thorough methodology with convincing validation. Results clearly support conclusions. Immediately useful for future work.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"5\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Exceptional.\"]],[5,\" Ambitious scope executed rigorously. Surprising findings, novel methods, or unusually robust validation.\"]]]]]]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Dimension 3: Presentation & Clarity\"]],[4,\"p\",{\"dir\":\"auto\"},[4,\"em\",null,[5,\"How clearly are work, findings, and impact potential communicated?\"]]],[4,\"figure\",{\"className\":\"framer-table-wrapper\"},[4,\"table\",null,[4,\"tbody\",null,[4,\"tr\",null,[4,\"th\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"Score\"]]],[4,\"th\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"Description\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"1\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Incomprehensible.\"]],[5,\" Cannot determine what the project is actually claiming or doing.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"2\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Hard to follow.\"]],[5,\" Key information buried, missing, or diluted by excessive length. Significant effort to extract main points.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"3\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Clear enough.\"]],[5,\" Can understand the problem, approach, and results without undue effort. Core content clearly present: problem, method, findings, limitations.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"4\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Well presented.\"]],[5,\" Easy to follow, well-structured, appropriate level of detail. Target audience would get it quickly.\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"5\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Exceptionally clear.\"]],[5,\" A pleasure to read. Complex ideas made accessible. Could serve as a model for how to present this type of work.\"]]]]]]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Submission Requirements\"]],[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Required:\"]]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Research report (PDF) using the \"],[2,{\"href\":\"https://docs.google.com/document/d/1PQBlhI3tM5vb51x7jBWXBQMYg6hkiU_x8RaCws4kjl4/copy?usp=sharing\",\"openInNewTab\":true,\"smoothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"qsRWxXDFi\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[5,\"official template\"]]],[5,\".\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Project title and abstract, 150 words or fewer.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Author names and affiliations.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"A \\\"Limitations and Dual-Use Considerations\\\" appendix (required, see below).\"]]]],[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Optional:\"]]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Public GitHub repo, subject to the disclosure review below. Do not publicly release novel installation recipes without review.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"A 3 to 5 minute video demo.\"]]]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Submission Template => \"],[2,{\"href\":\"https://docs.google.com/document/d/1PQBlhI3tM5vb51x7jBWXBQMYg6hkiU_x8RaCws4kjl4/copy?usp=sharing\",\"openInNewTab\":true,\"smoothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"qsRWxXDFi\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[5,\"Link\"]]]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Recommended Report Structure\"]],[4,\"p\",{\"dir\":\"auto\"},[4,\"strong\",null,[5,\"Maximum 8 pages, not counting references and appendices.\"]],[5,\" Most strong projects are 4 to 8 pages.\"]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Introduction:\"]],[5,\" which track and sub-problem, why it matters, and what the artifact is for.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Related Work:\"]],[5,\" what you build on.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Methodology:\"]],[5,\" enough to replicate, with sources and assumptions stated.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Results:\"]],[5,\" quantitative where possible, with the main threat to validity stated.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Discussion:\"]],[5,\" implications, limitations, future work.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Limitations & Dual-Use Considerations\"]],[5,\" (required).\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"References.\"]]]]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"AI tools and your report\"]],[4,\"p\",{\"dir\":\"auto\"},[5,\"Use AI tools the way you would use a colleague: to check your reasoning, find gaps in a draft, or debug code. The report itself has to be your team's own writing about your team's own work. Judges read every submission, and a report that reads as generated rather than written (generic framing, padded sections, claims without sources, no trace of what you actually did) will not be scored. Keep it short, say what you did in your own words, and link the sources for every factual claim.\"]],[4,\"h2\",{\"dir\":\"ltr\"},[5,\"Publishing your work\"]],[4,\"p\",{\"dir\":\"ltr\"},[5,\"We encourage teams to publish their submission, and LessWrong is a natural venue for most of the written ones. Write-ups from this sprint will hold value if they follow a few rules: state your epistemic status and don’t use LLMs for writing on Lesswrong, only use LLMs to find problems in your drafts, not to draft it; link the primary sources for every factual claim about the incident; pick a title that states the finding rather than the topic; and publish the imperfect version this month rather than the polished one in three. We will link the best posts from the sprint page. Maximum of 1500 words for written contributions, without counting appendixes. The quality and value of what you write is worth much more than the length.\"]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Important Notes\"]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Solo vs team:\"]],[5,\" enter solo or as a team. Teams of up to 5 are recommended; larger groups are allowed.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Do not use any model to breach into any organisation or commit any other type of \"],[2,{\"href\":\"https://www.felonybench.com/\",\"openInNewTab\":true,\"smoothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"qsRWxXDFi\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[5,\"felony\"]]],[5,\". \"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Building on existing work:\"]],[5,\" allowed and encouraged, disclose what you built on.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Fixing or resubmitting:\"]],[5,\" submit again before the deadline using the exact same title and details; your new files replace the old ones.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Where to submit:\"]],[5,\" through the official submission form on the hackathon page.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Support:\"]],[5,\" the \"],[2,{\"href\":\"https://discord.gg/ssZDasNkSE\",\"openInNewTab\":false,\"smoothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"qsRWxXDFi\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[5,\"Discord help-desk channel\"]]],[5,\", tag @Support, or email sprints@apartresearch.com.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Pre-submission checklist:\"]],[5,\" report PDF, abstract 150 words or fewer, author and affiliations, Limitations and Dual-Use appendix, 8 pages or fewer, novel-installation results withheld pending review.\"]]]],[4,\"h2\",{\"dir\":\"auto\"},[5,\"Frequently Asked Questions\"]],[4,\"h3\",{\"dir\":\"auto\"},[5,\"Getting started\"]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"How does the sprint work?\"]],[5,\" Sign up, join the Discord server, form or join a team (or work solo), pick a track and a problem, build over the weekend, and submit a research report (PDF) by the deadline. Talks and Q&A run throughout.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Can I participate remotely?\"]],[5,\" Yes. This is an online event. All talks, collaboration, and submissions happen through Discord and Zoom.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"How do teams work?\"]],[5,\" Teams form before or during the sprint. Use the team-forming channels on Discord to find collaborators. Solo is fine. We recommend teams of up to 5, but larger groups are allowed.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Do tracks affect scoring?\"]],[5,\" All projects are scored on the same rubric. Tracks guide judging via the track-specific criterion, and you compete across all submissions.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"What background is required?\"]],[5,\" None specific. Many participants come from ML, interpretability, AI safety, or security backgrounds. The Resources tab has everything you need to get up to speed. See \\\"Who should join\\\" on the Overview tab.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Are compute credits provided?\"]],[5,\" No. \"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Do I need to attend all three days?\"]],[5,\" No. You can work at your own pace. Talks are optional but recommended. The only hard deadline is the Sunday submission cutoff.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Can I participate from any country?\"]],[5,\" Yes. The sprint is open globally.\"]]]],[4,\"h3\",{\"dir\":\"auto\"},[5,\"Submissions\"]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"What do I submit?\"]],[5,\" A research report in PDF format using the official template. Think of it as a mini research paper documenting your problem, approach, results, and implications, not a product demo. Include the required Limitations and Dual-Use Considerations appendix.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Which template should I use?\"]],[5,\" Always use the one linked on the Guidelines tab. The template in any acceptance email may be older.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Will I get a confirmation after submitting?\"]],[5,\" Yes. You will get a confirmation with your project title shortly after submitting. If you do not, email sprints@apartresearch.com.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"My project doesn't show up on the website after submitting.\"]],[5,\" Submissions are published manually and can take up to 12 hours to appear. If it is still missing after that, email sprints@apartresearch.com.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"I made a mistake. Can I fix it or update my PDF?\"]],[5,\" Yes. Submit again using the exact same title and details, just fix what was wrong. Your new files replace the old ones. If unsure, ask in the help-desk channel and tag @Support first.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Can I add team members after submitting?\"]],[5,\" Yes. Update the team list through the submission form. If you need help, ask in the help-desk channel and tag @Support.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Can I submit unfinished work?\"]],[5,\" Yes. Submitting something unfinished is always better than not submitting. Judges evaluate what you accomplished in the timeframe; honest limitations are welcome.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Can I build on existing research?\"]],[5,\" Yes, but you must clearly identify what is new work done during the sprint. Undisclosed prior work can lead to disqualification.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Can I submit multiple projects?\"]],[5,\" Yes, but each needs its own submission with a unique title. Most participants focus on one.\"]]]],[4,\"h3\",{\"dir\":\"auto\"},[5,\"Judging and results\"]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"How does judging work?\"]],[5,\" Your project is assigned to expert judges who review your PDF and score it on the rubric above. Judges typically have about a week after the event to complete reviews.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"Are individual judge scores shared?\"]],[5,\" No. The rubric is public, but individual scores stay internal. Constructive feedback is shared with participants without reviewer names.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"When will results be announced?\"]],[5,\" Typically 1 to 2 weeks after the judging deadline. Winners are contacted directly, and all participants receive reviewer feedback by email.\"]]]],[4,\"h3\",{\"dir\":\"auto\"},[5,\"Support\"]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[2,{\"href\":\"https://discord.gg/ssZDasNkSE\",\"openInNewTab\":false,\"smoothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"qsRWxXDFi\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[5,\"help-desk\"]]],[5,\" channel for questions, tag @Support.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Event announcements and updates: posted on Discord.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[4,\"strong\",null,[5,\"projects|teams\"]],[5,\" channel for team formation and finding collaborators.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Email: sprints@apartresearch.com\"]]]]]",{"type":27,"value":38},{"collectionId":29,"pointer":39},"[1,[4,\"figure\",{\"className\":\"framer-table-wrapper\"},[4,\"table\",null,[4,\"tbody\",null,[4,\"tr\",null,[4,\"th\",{\"colSpan\":\"3\"},[4,\"p\",{\"dir\":\"auto\"},[5,\"Thursday September 10\"]]]],[4,\"tr\",null,[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"14:15 UTC\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[5,\"Justin Shenk, Independent AI Safety Researcher\"]]],[4,\"td\",null,[4,\"p\",{\"dir\":\"auto\"},[2,{\"href\":\"https://luma.com/ai-incident-response-sprint-justin-shenk\",\"openInNewTab\":true,\"smoothScroll\":false,\"relValues\":[],\"motionChil