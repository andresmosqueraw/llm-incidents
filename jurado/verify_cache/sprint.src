},[5,\"hosted by AI Safety Colombia in Chicó, north Bogotá. We cover meals for the whole weekend, part of each team's compute costs, and bring local mentors and speakers.\"]]]",{"type":6,"value":174},"ai-incident-response-sprint-bogotá-hub",{"type":6,"value":176},"M2KeXX9yyGCwN7XwGJ1buob",{"DT2CqGi3O":178,"aVBRrXN5Q":179,"QH3aPfuKl":181,"Fqul0F7dy":184,"id":186},{"type":117,"value":131},{"type":6,"value":180},"AI Incident Response Sprint - Cape Town Hub",{"type":27,"value":182},{"collectionId":123,"pointer":183},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"Join the Cape Town hub for the AI Incident Research Sprint! We will be working from a comfortable co-working space. We will provide lunch for both days of the sprint.\"]]]",{"type":6,"value":185},"ai-incident-response-sprint-cape-town-hub",{"type":6,"value":187},"M76e0GudzzyrmAbfw3FsK6e",{"DT2CqGi3O":189,"aVBRrXN5Q":191,"QH3aPfuKl":193,"Fqul0F7dy":196,"id":198},{"type":117,"value":190},"https://luma.com/mbwgvacy",{"type":6,"value":192},"The AI Escaped. Now What? — Melbourne Incident Response Sprint",{"type":27,"value":194},{"collectionId":123,"pointer":195},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"An AI escaped its sandbox. Spend Saturday helping write the incident-response playbook we wish already existed—no coding or prior expertise required.  \"]],[4,\"p\",{\"dir\":\"auto\"},[5,\"Join us in the computer room at Kathleen Syme Library and Community Centre, Melbourne, then finish and submit your project from home on Sunday.\"]]]",{"type":6,"value":197},"the-ai-escaped-now-what-melbourne-incident-response-sprint",{"type":6,"value":199},"M5oQVReqsl8okPUY4qOd0v0","{\"from\":\"7066e68e-7f30-4891-b6c3-f324c6cf270a\",\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[\"QTfdffMrP\",\"Ky_LefaM9\",\"tB1hI8d7Q\",\"T4h7XEZ8i\",\"yrorK8VeY\",\"QE7NJVYWk\",\"fsPlWRhDi\",\"SyxEqinYW\",\"yfK94DRUW\",\"M8Iryp4Bw\",\"D39t1zCCc\",\"Wmdk7wQ9r\",\"bEC4movaA\",\"iMoQosX94\",\"oiWD4luZy\",\"amc4flgjw\"]},{\"collection\":\"c_XgPW6aE